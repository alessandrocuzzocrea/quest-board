{
  "name": "quest-board",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "containerEnv": {
    "DATABASE_URL": "postgres://postgres:quest@localhost:5432/quest",
    "APP_SECRET": "devcontainer-secret-change-in-prod"
  },
  "forwardPorts": [3001, 5173],
  "portsAttributes": {
    "3001": { "label": "Backend API", "onAutoForward": "openBrowser" },
    "5173": { "label": "Frontend Dev Server", "onAutoForward": "openPreview" }
  },
  "postCreateCommand": {
    "bun": "curl -fsSL https://bun.sh/install | bash",
    "frontend-deps": "bash -c 'source ~/.bashrc && cd app && bun install'"
  },
  "postStartCommand": "docker compose up -d db --wait",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next",
        "github.vscode-github-actions"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "rust-analyzer.checkOnSave": true,
        "files.watcherExclude": {
          "**/target/**": true,
          "**/app/node_modules/**": true,
          "**/app/dist/**": true
        }
      }
    }
  }
}
